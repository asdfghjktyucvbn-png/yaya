<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>¡Feliz Cumpleaños!</title>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

  <!-- Tipografías -->
  <link href="https://fonts.googleapis.com/css2?family=Dancing+Script:wght@500;700&family=Playfair+Display:wght@600;700;800&display=swap" rel="stylesheet">

  <style>
    html, body {
      width: 100%;
      height: 100%;
      margin: 0;
      background: linear-gradient(to bottom, #071a3d, #1976b9, #87ceeb);
      font-family: 'Dancing Script', cursive;
      overflow: hidden;
    }

    #mensaje {
      position: absolute;
      top: 40px;
      width: 100%;
      padding: 0 12px;
      box-sizing: border-box;
      text-align: center;
      font-family: 'Playfair Display', serif;
      font-size: clamp(1.8rem, 5vw, 3.5rem);
      font-weight: 800;
      color: #ffffff;
      display: none;
      animation: aparecer 2s forwards;
      text-shadow: 0 0 10px rgba(135, 206, 235, 0.8),
                   3px 3px 8px rgba(0, 0, 0, 0.6);
      z-index: 10;
    }

    @keyframes aparecer {
      from {
        opacity: 0;
        transform: translateY(-20px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    #contenedor {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      height: 100%;
      cursor: pointer;
      text-align: center;
    }

    #regalo {
      width: 280px;
      max-width: 80vw;
      height: auto;
      border-radius: 15px;
      filter: drop-shadow(0 8px 15px rgba(0, 0, 0, 0.35));
      transition: transform 0.5s ease, opacity 0.5s ease;
    }

    #regalo:hover {
      transform: scale(1.05);
    }

    #toca {
      margin-top: 15px;
      font-size: 2em;
      color: #ffffff;
      text-shadow: 2px 2px 6px #000;
      animation: latir 1.2s infinite;
      transition: opacity 0.5s ease;
    }

    @keyframes latir {
      0%, 100% {
        transform: scale(1);
      }
      50% {
        transform: scale(1.1);
      }
    }

    /* Pastel animado */
    #cake {
      display: none;
      position: absolute;
      top: 55%;
      left: 50%;
      transform: translate(-50%, -50%);
      z-index: 5;
      opacity: 0;
      animation:
        aparecerPastel 1s forwards 0.5s,
        flotar 3s ease-in-out infinite 1.5s;
    }

    @keyframes aparecerPastel {
      from {
        opacity: 0;
        transform: translate(-50%, -40%);
      }
      to {
        opacity: 1;
        transform: translate(-50%, -50%);
      }
    }

    @keyframes flotar {
      0%, 100% {
        transform: translate(-50%, -50%) translateY(0) rotate(0);
      }
      25% {
        transform: translate(-50%, -50%) translateY(-10px) rotate(1deg);
      }
      50% {
        transform: translate(-50%, -50%) translateY(-5px) rotate(0);
      }
      75% {
        transform: translate(-50%, -50%) translateY(-15px) rotate(-1deg);
      }
    }

    #cake img {
      display: block;
      width: 400px;
      max-width: 88vw;
      max-height: 65vh;
      object-fit: contain;
      border-radius: 15px;
      filter: drop-shadow(0 10px 20px rgba(0, 0, 0, 0.4));
      animation: latidoSuave 2s ease-in-out infinite;
    }

    @keyframes latidoSuave {
      0%, 100% {
        transform: scale(1);
      }
      50% {
        transform: scale(1.05);
      }
    }

    /* Confeti */
    .confeti {
      position: absolute;
      top: -20px;
      width: 10px;
      height: 10px;
      opacity: 0;
      z-index: 20;
      pointer-events: none;
    }

    @keyframes confeti-lluvia {
      0% {
        transform: translateY(-20px) rotate(0deg);
        opacity: 1;
      }
      100% {
        transform: translateY(110vh) rotate(720deg);
        opacity: 0;
      }
    }

    @media (max-height: 600px) {
      #mensaje {
        top: 15px;
      }

      #cake {
        top: 58%;
      }

      #cake img {
        max-height: 55vh;
      }
    }
  </style>
</head>

<body>

  <div id="mensaje"> ¡Feliz Cumpleaños Yaya! </div>

  <div id="contenedor" onclick="mostrarPastel()">
    <img
      id="regalo"
      src="https://www.dropbox.com/scl/fi/jvouvmh7gi6obn5xexp7n/f5a58b20f874e82eaba6ce9c95f54bc7-removebg-preview.png?rlkey=jjy7blwpeo89hhrf3lp912kwq&st=neezwov0&raw=1"
      alt="Regalo de cumpleaños"
    >

    <div id="toca">✨ ¡Toca el regalo! ✨</div>
  </div>

  <div id="cake">
    <img
      src="https://www.dropbox.com/scl/fi/d64bw9p43j3s3g1ruhkfu/be956b4c687aead8cdf41d0918187ea9.gif?rlkey=w5fl5hnwdpiocmo252pbnglea&st=yffkp5ty&raw=1"
      alt="Pastel animado de cumpleaños"
    >
  </div>

  <audio id="cancion" loop preload="none">
    <source
      src="https://www.dropbox.com/scl/fi/jyyogrrufp6mapxltjsv8/Vicente-Fern-ndez-Un-Mill-n-de-Primaveras-Letra-Lyrics.mp3?rlkey=wajwleatuv5162x3dux5dl36q&st=482p91ep&raw=1"
      type="audio/mpeg"
    >
    Tu navegador no soporta audio.
  </audio>

  <script>
    let mostrado = false;
    let intervaloConfeti;

    function mostrarPastel() {
      if (mostrado) return;
      mostrado = true;

      const regalo = document.getElementById('regalo');
      const toca = document.getElementById('toca');
      const contenedor = document.getElementById('contenedor');
      const cake = document.getElementById('cake');
      const mensaje = document.getElementById('mensaje');
      const audio = document.getElementById('cancion');

      // Ocultar el regalo
      regalo.style.opacity = '0';
      toca.style.opacity = '0';

      setTimeout(() => {
        contenedor.style.display = 'none';
      }, 500);

      // Mostrar el pastel y el mensaje
      setTimeout(() => {
        cake.style.display = 'block';
        mensaje.style.display = 'block';

        // Iniciar lluvia de confeti
        crearConfeti();
        intervaloConfeti = setInterval(crearConfeti, 2000);

        // Reproducir la canción tras la interacción del usuario
        audio.volume = 0.7;
        audio.play().catch(error => {
          console.warn(
            'No se pudo reproducir la música. Comprueba el enlace o intenta iniciar la reproducción nuevamente.',
            error
          );
        });
      }, 500);
    }

    function crearConfeti() {
      const colores = [
        '#ffffff',
        '#87ceeb',
        '#4ecdc4',
        '#ffe66d',
        '#ff9ff3',
        '#54a0ff',
        '#c8b6ff'
      ];

      for (let i = 0; i < 50; i++) {
        const confeti = document.createElement('div');
        confeti.className = 'confeti';

        confeti.style.backgroundColor =
          colores[Math.floor(Math.random() * colores.length)];

        confeti.style.left = Math.random() * 100 + 'vw';

        confeti.style.animation =
          `confeti-lluvia ${Math.random() * 3 + 2}s linear forwards`;

        confeti.style.animationDelay = Math.random() + 's';
        confeti.style.width = Math.random() * 12 + 6 + 'px';
        confeti.style.height = Math.random() * 12 + 6 + 'px';

        confeti.style.borderRadius =
          Math.random() > 0.5 ? '50%' : '2px';

        document.body.appendChild(confeti);

        setTimeout(() => {
          confeti.remove();
        }, 6000);
      }
    }

    // Limpiar el intervalo al salir
    window.addEventListener('beforeunload', () => {
      if (intervaloConfeti) {
        clearInterval(intervaloConfeti);
      }
    });
  </script>

</body>
</html>
